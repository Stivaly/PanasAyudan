# Bloquea los scripts de ciclo de vida (preinstall/install/postinstall) de TODAS
# las dependencias al instalar. Es el vector principal de los ataques de cadena
# de suministro tipo Shai-Hulud: un paquete comprometido ejecuta código arbitrario
# en el momento de `npm install`.
# Ninguna dependencia actual del proyecto requiere scripts de instalación
# (verificado: 0 hooks preinstall/postinstall en package-lock.json).
# Si una dependencia futura los necesita, ejecutar su script puntualmente con:
#   npm rebuild <paquete> --foreground-scripts
ignore-scripts=true

# Los `npm audit` siguen funcionando; `npm run <script>` del propio proyecto
# (dev, build, lint) NO se ve afectado por ignore-scripts.
