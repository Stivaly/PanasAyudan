# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Google Maps
# Habilitar en Google Cloud: Maps JavaScript API, Places API (New) y
# Distance Matrix API. La Places API legacy NO sirve para keys nuevas.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=tu-google-maps-key

# Map ID requerido por los marcadores avanzados (AdvancedMarkerElement).
# Crea uno en Google Cloud (Map Management) y asígnale un estilo oscuro;
# el tema del mapa se configura ahí, no en el código. DEMO_MAP_ID solo para probar.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=tu-map-id
